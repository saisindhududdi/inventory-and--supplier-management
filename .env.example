# ============================================================
# Environment Variables Configuration for Vercel & Local Dev
# ============================================================

# GEMINI_API_KEY: Optional. Your Google AI Studio / Gemini API key.
# If omitted or left blank, the application automatically activates
# its built-in rule-based fallback intelligence engine.
GEMINI_API_KEY=""

# SECRET_KEY: Optional. Secret key used by Flask for session management.
SECRET_KEY="college-mini-project-secret-key-2026"

# FLASK_DEBUG: Set to "False" for production on Vercel, "True" for local development.
FLASK_DEBUG="False"

# VITE_API_BASE_URL: Optional. Base URL for backend API requests.
# Leave blank ("") when frontend and API are served from the same Vercel deployment (relative /api routes).
# Only set if using cross-domain or multi-service routing (e.g., https://api.yourdomain.com).
VITE_API_BASE_URL=""
